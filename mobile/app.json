{
  "expo": {
    "name": "Happy Renting",
    "slug": "happy-renting-tenant",
    "sdkVersion": "56.0.0",
    "version": "2.4.2",
    "orientation": "default",
    "icon": "./assets/images/main-app-icon.png",
    "scheme": "happyrenting",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.happyrenting.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.in.happyrenting.tenant",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=co.in.happyrenting.tenant",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Happy Renting needs access to your photos to upload payment proof."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Happy Renting uses Face ID for quick and secure login."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c66fc8a-93a0-4b25-a211-41a3b4bc9e99"
      },
      "apiUrl": "https://happy-renting.onrender.com/api",
      "privacyPolicyUrl": "https://happy-renting.onrender.com/privacy",
      "termsOfServiceUrl": "https://happy-renting.onrender.com/terms"
    },
    "owner": "vedanthcy"
  }
}

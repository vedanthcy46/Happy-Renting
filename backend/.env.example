# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ─────────────────────────────────────────
# Replace with your Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/happyrent?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────
# Use a long, random 256-bit secret — never commit the real value
JWT_SECRET=change_this_to_a_256_bit_random_secret_before_production
JWT_EXPIRES_IN=7d

# ─── AI Assistant (Property Management Copilot) ─────────────────
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model (default llama-3.3-70b-versatile).
# Use llama-3.3-70b-versatile (tool calling) or llama-3.1-8b-instant (faster).
GROQ_MODEL=llama-3.3-70b-versatile
# Rate limit for the AI endpoint (messages per minute, per IP)
AI_RATE_LIMIT_PER_MIN=10

# ─── AI Automation (Phase 4) ────────────────────────────────────
# Send automatic rent reminders to tenants with pending rent (in-app + push).
# Set to "false" to disable the daily job. Schedule uses 6-field cron (IST).
RENT_REMINDER_AUTOMATION_ENABLED=true
RENT_REMINDER_CRON=0 9 * * *

# Monthly business report PDFs (emailed to each owner on the 1st of month).
MONTHLY_REPORT_AUTOMATION_ENABLED=true
MONTHLY_REPORT_CRON=0 10 1 * *

# ─── Daily Digests ──────────────────────────────────────────────
# Sent in the evening so "today" collections aren't zero (IST).
OWNER_DIGEST_CRON=0 21 * * *
ADMIN_DIGEST_CRON=0 21 * * *

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:3000

# ─── Seed Admin (bootstrap only) ───────────────────────────
SEED_ADMIN_EMAIL=admin@happyrent.com
SEED_ADMIN_PASSWORD=Admin@HappyRent2024!

# ─── Expo Push Notifications ───────────────────────────────
# Required if push security is enabled on expo.dev
# Get it from: https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=


# Enable internal keep-alive ping scheduler
KEEP_ALIVE_ENABLED=false
# Interval for internal pings (default 5 mins)
KEEP_ALIVE_INTERVAL_MS=300000
# Target URL for self-ping (should be your deployed API URL)
KEEP_ALIVE_URL=https://happy-renting.onrender.com/health
# Optional API Key to protect detailed health metrics
HEALTH_API_KEY=your_secure_health_api_key_here
